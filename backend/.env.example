# =====================================================================
# TRIVAANA AI — Production Environment Variables
# Copy to .env in backend/ or root directory.
# NEVER commit live production secrets to version control.
# =====================================================================

# Server & Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=trivaana-dev-secret-key-change-in-production-981a27e
JWT_EXPIRE_MINUTES=1440

# Database
# Defaults to Path.home() / ".trivaana" / "trivaana_saas.db"
# TRIVAANA_DATA_DIR=/path/to/persistent/data

# Telephony Carrier 1: Exotel (Recommended for India PSTN)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_PHONE_NUMBER=

# Telephony Carrier 2: Twilio (Global PSTN Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vernacular Voice AI Synthesizers
# Sarvam AI for low-latency Indic vernacular dialects (Telugu, Hindi, Kannada, Tamil)
SARVAM_API_KEY=
# ElevenLabs for ultra-low latency multilingual v2 models
ELEVENLABS_API_KEY=

# Payment Gateway: Razorpay (India & Global Cards)
# When keys are blank, system safely operates in server-verified sandbox mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta)
# Used for automated post-call booking links and summaries
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
