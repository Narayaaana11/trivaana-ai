# =====================================================================
# TRIVAANA AI — Master Environment Configuration Example
# Copy to .env in project root or backend/.env. Never commit real secrets.
# =====================================================================

# Core Application & Security
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8001
JWT_SECRET=change-this-to-a-secure-random-64-character-secret-in-production
JWT_EXPIRE_MINUTES=1440
APP_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ALLOW_DEMO_SEEDING=false
ALLOW_SANDBOX_TOPUP=false

# AI Reasoning & Prompt Engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voice Providers
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
INDICF5_ENDPOINT=
FASTER_WHISPER_ENDPOINT=

# LiveKit Real-Time Voice Agent Framework
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_CONFIG=

# Telephony Providers
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_SID=
EXOTEL_PHONE_NUMBER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=

# Transactional Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@trivaana.ai
SMTP_USE_TLS=true

# Messaging & Calendar Integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database & Background Processing
DATABASE_URL=postgresql://trivaana:trivaana_pass@postgres:5432/trivaana
REDIS_URL=redis://redis:6379/0

# S3-Compatible Object Storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=trivaana-media

# Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

